# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Xcode — the project is generated from MyNotesSwiftUI/project.yml by
# `xcodegen generate`, so the .xcodeproj is derived and must not be committed.
*.xcodeproj/
*.xcworkspace/
!default.xcworkspace
xcuserdata/
DerivedData/
*.xcuserstate
*.xcscmblueprint
*.moved-aside

# macOS
.DS_Store
*.pem

# CloudKit / signing material — never commit keys or provisioning profiles
*.p8
*.p12
*.key
*.jks
*.mobileprovision
*.orig.*

# Local environment
.env
.env*.local

# Tooling
*.log
*.tmp
